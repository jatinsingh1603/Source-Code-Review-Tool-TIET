{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "rules": [
            {
              "id": "rules.os-system",
              "name": "os-system",
              "properties": {
                "tags": [
                  "CWE-78"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "rules.os-system",
          "level": "error",
          "message": {
            "text": "os.system with a variable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 5
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
