      "results": [
        {
          "message": {
            "text": "Untrusted input concatinated with raw SQL query can result in SQL Injection."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "region": {
                  "snippet": {
                    "text": "  connection.query(\"select * from t where a=\" + req.query.a, function (e, r) { res.send(r); });"
                  },
                  "endColumn": 95,
                  "endLine": 7,
                  "startColumn": 3,
                  "startLine": 7
                },
                "artifactLocation": {
                  "uri": "server.js"
                }
              }
            }
          ],
          "properties": {
            "owasp-web": "A1: Injection",
            "cwe": "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
          },
          "ruleId": "node_sqli_injection",
          "ruleIndex": 0
        },
        {
          "message": {
            "text": "User controlled data in 'child_process.exec()' can result in Remote OS Command Execution."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "region": {
                  "snippet": {
                    "text": "  cp.exec(\"ls \" + req.query.dir);"
                  },
                  "endColumn": 33,
                  "endLine": 8,
                  "startColumn": 3,
                  "startLine": 8
                },
                "artifactLocation": {
                  "uri": "server.js"
                }
              }
            }
          ],
          "properties": {
            "owasp-web": "A1: Injection",
            "cwe": "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
          },
          "ruleId": "generic_os_command_exec",
          "ruleIndex": 1
        },
        {
          "message": {
            "text": "User controlled data in eval() or similar functions may result in Server Side Injection or Remote Code Injection"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "region": {
                  "snippet": {
                    "text": "  eval(req.query.code);"
                  },
                  "endColumn": 23,
                  "endLine": 9,
                  "startColumn": 3,
                  "startLine": 9
                },
                "artifactLocation": {
                  "uri": "server.js"
                }
              }
            }
          ],
          "properties": {
