            "cwe": "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
          },
          "ruleId": "eval_nodejs",
          "ruleIndex": 2
        },
        {
          "message": {
            "text": "Untrusted User Input in Response will result in Reflected Cross Site Scripting Vulnerability."
