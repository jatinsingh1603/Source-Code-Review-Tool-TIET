      "invocations": [
        {
          "executionSuccessful": true,
          "endTimeUtc": "2026-11-12T21:54:20Z"
        }
      ],
      "results": [
        {
          "message": {
            "text": "User controlled data in 'child_process.exec()' can result in Remote OS Command Execution."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "region": {
                  "snippet": {
                    "text": "  cp.exec('ls ' + req.query.dir);  // PG-VULN-002"
                  },
                  "endColumn": 33,
                  "endLine": 6,
                  "startColumn": 3,
                  "startLine": 6
                },
                "artifactLocation": {
                  "uri": "server.js"
                }
              }
            }
          ],
          "properties": {
            "owasp-web": "A1: Injection",
            "cwe": "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
          },
          "ruleId": "generic_os_command_exec",
          "ruleIndex": 0
        }
      ]
    }
