{
  "config_version": 1,
  "engines": {
    "disabled": [],
    "enabled": [],
    "native": {
      "iac": true,
      "rules": true,
      "sca": true,
      "secrets": true,
      "taint": true
    },
    "options": {},
    "rule_packs": [
      "default"
    ],
    "rule_paths": [],
    "timeout_seconds": 600
  },
  "ingest": {
    "excludes": [
      "node_modules",
      "vendor",
      "build",
      "dist",
      ".git",
      "**/*.min.js"
    ],
    "follow_symlinks": false,
    "legacy_encoding": "cp1252",
    "max_archive_ratio": 100,
    "max_depth": 25,
    "max_file_size_bytes": 5000000,
    "max_files": 50000,
    "max_total_bytes": 2000000000,
    "respect_gitignore": true
  },
  "integrations": {
    "github": {
      "api_url": "https://api.github.com/",
      "checks": false,
      "close_resolved": true,
      "dry_run": true,
      "enabled": false,
      "issue_sync": false,
      "labels_prefix": "codekavach",
      "max_issues_per_run": 50,
      "min_severity_for_issues": "medium",
      "project_number": null,
      "project_owner": null,
      "repository": null,
      "sarif_upload": false,
      "token": null
    },
    "mcp": {
      "allow_non_loopback": false,
      "bind": "127.0.0.1:8765",
      "enabled": false,
      "transport": "stdio"
    }
  },
  "llm": {
    "allow_remote": false,
    "budget": {
      "max_cost_usd": null,
      "max_requests": null,
      "max_total_input_tokens": null,
      "max_total_output_tokens": null
    },
    "cache": true,
    "consensus": 1,
    "default_provider": "auto",
    "enabled": true,
    "max_output_tokens": 2048,
    "max_retries": 2,
    "model": null,
    "providers": {
      "mock": {
        "allow_insecure_http": false,
        "api_key": null,
        "api_version": null,
        "aws_profile": null,
        "azure_deployment": null,
        "base_url": null,
        "cassette_dir": null,
        "command": null,
        "enabled": true,
        "kind": "mock",
        "model": null,
        "options": {},
        "region": null,
        "trust_tier": null
      }
    },
    "tasks": [
      "triage",
      "explain",
      "remediate",
      "summarise"
    ],
    "temperature": 0.0,
    "timeout_seconds": 120
  },
  "logging": {
    "format": "console",
    "level": "info"
  },
  "parsing": {
    "max_node_count": 2000000,
    "max_source_bytes": 2000000,
    "timeout_seconds": 5.0
  },
  "plugins": {
    "allow_distributions": [],
    "disable": []
  },
  "privacy": {
    "detect": {
      "min_confidence": "low"
    },
    "domain_terms": [],
    "domain_terms_file": null,
    "egress": {
      "aggregation_budget_pct": 100.0,
      "encrypt_at_rest": true,
      "max_payload_bytes": 262144,
      "provider_host_allowlist": [],
      "proxy_trust": "none",
      "proxy_url": null,
      "rate_per_minute": 60,
      "scanner_timeout_seconds": 5.0,
      "ticket_ttl_seconds": 60
    },
    "level": "L0",
    "min_level": "L0",
    "never_send": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/*.jks",
      "**/id_rsa*",
      "**/id_ed25519*"
    ],
    "paths": [],
    "pii_locales": [
      "intl",
      "in"
    ],
    "provider_tier_levels": {
      "local": "L1",
      "private": "L2",
      "public": "L3"
    },
    "pseudonym": {
      "link_mode": "per_scan",
      "role_hints": false
    },
    "public_allowlist_extra": [],
    "slice": {
      "callee_depth": 1,
      "default_strategy": "enclosing_function",
      "defuse_depth": 20,
      "max_needs_context_rounds": 2,
      "max_tokens": 2048
    },
    "vault": {
      "key_source": "keyring",
      "kms": {
        "endpoint": null,
        "host_allowlist": [],
        "key_id": null,
        "timeout_seconds": 5.0,
        "token": null
      },
      "passphrase": null,
      "retention_days": null
    }
  },
  "profile": "airgapped",
  "profiles": {},
  "project": {
    "client": null,
    "description": null,
    "languages": [],
    "name": null
  },
  "reporting": {
    "auditor": null,
    "classification": "Confidential",
    "compliance": [
      "owasp-top10",
      "cwe-top25",
      "pci-dss",
      "iso27001",
      "nist-ssdf"
    ],
    "formats": [
      "html",
      "sarif",
      "json"
    ],
    "include_privacy_attestation": true,
    "logo": null,
    "min_severity": "info",
    "output_dir": "codekavach-report",
    "snippet_context_lines": 3,
    "template_dir": null,
    "title": null
  },
  "scan": {
    "cache": true,
    "cache_keep_scans": 5,
    "cache_max_size_mb": 2048,
    "exclude": [
      ".git/**",
      ".codekavach/**",
      "node_modules/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "dist/**",
      "build/**",
      "target/**",
      "vendor/**"
    ],
    "fail_on": "high",
    "follow_symlinks": false,
    "include": [
      "**/*"
    ],
    "jobs": 0,
    "max_file_size_kb": 1024,
    "max_files": 50000,
    "max_total_size_mb": 2048,
    "respect_gitignore": true,
    "skip_stages": [],
    "stage_timeout_seconds": 1800,
    "stage_timeouts": {},
    "timeout_seconds": 3600
  }
}
