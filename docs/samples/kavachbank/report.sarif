            {
              "id": "secret.razorpay_key_secret",
              "name": "UseOfHardCodedCredentials",
              "shortDescription": {
                "text": "Hard-coded credential of type razorpay_key_secret (masked preview ab****** (24 chars), entropy 4.58 bits/char)."
              },
              "fullDescription": {
                "text": "Hard-coded credential of type razorpay_key_secret (masked preview ab****** (24 chars), entropy 4.58 bits/char). A credential such as a password, API key or token is embedded in the source code."
