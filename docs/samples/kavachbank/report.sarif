            {
              "id": "taint.http_param.http",
              "name": "ServerSideRequestForgery",
              "shortDescription": {
                "text": "Data from a http_param source reaches a http sink (fetch)"
              },
              "fullDescription": {
                "text": "Data from a http_param source reaches a http sink (fetch). The server issues an outbound request to a URL that the caller chooses, without restricting the destination."
              },
              "help": {
                "text": "Do not fetch URLs taken from requests. Where the feature needs it, allow-list the scheme, host and port, resolve the host and refuse private, loopback and link-local addresses (including cloud metadata endpoints), disable redirects, and send outbound requests through an egress proxy.\n\nRoute outbound calls through an egress proxy with an allow-list, and enforce IMDSv2 or the equivalent metadata protection on cloud hosts.",
                "markdown": "**Fix now.** Do not fetch URLs taken from requests. Where the feature needs it, allow-list the scheme, host and port, resolve the host and refuse private, loopback and link-local addresses (including cloud metadata endpoints), disable redirects, and send outbound requests through an egress proxy.\n\n**Prevent recurrence.** Route outbound calls through an egress proxy with an allow-list, and enforce IMDSv2 or the equivalent metadata protection on cloud hosts."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "defaultConfiguration": {
                "level": "error"
