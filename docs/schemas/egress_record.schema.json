{
  "$defs": {
    "EgressOutcome": {
      "description": "Outcome recorded by an egress ledger entry.",
      "enum": [
        "sent",
        "blocked",
        "completed",
        "failed"
      ],
      "title": "EgressOutcome",
      "type": "string"
    },
    "PrivacyLevel": {
      "description": "Privacy level, ordered by strictness, not by the digit: L1 < L2 < L3 < L4 < L0.\n\nRank (ADR E03-01 decision D5): L1=1, L2=2, L3=3, L4=4, L0=5. L0 sends nothing, L4 sends\nabstract facts but no code, L3 a pseudonymised slice, L2 pseudonymised files and L1 code with\nonly secrets and PII replaced. Comparisons mean \"stricter than\", ``strictest`` returns the\nmaximum by rank, and ``at_least`` checks a floor. Ordering by the digit would make L0 the\nweakest level and silently turn a floor of L3 into permission for L1.",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L0"
      ],
      "title": "PrivacyLevel",
      "type": "string"
    },
    "TokenCounts": {
      "additionalProperties": false,
      "description": "Token counts of one request; estimated until the provider reports them.",
      "properties": {
        "completion": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion"
        },
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        },
        "prompt": {
          "minimum": 0,
          "title": "Prompt",
          "type": "integer"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "TokenCounts",
      "type": "object"
    }
  },
  "$id": "urn:codekavach:schema:egress_record:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One ledger entry: what left (or would have left) the machine, and when.",
  "properties": {
    "block_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block Code"
    },
    "candidate_id": {
      "anyOf": [
        {
          "pattern": "^cand_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Id"
    },
    "entry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Entry Hash",
      "type": "string"
    },
    "level": {
      "$ref": "#/$defs/PrivacyLevel"
    },
    "model": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/EgressOutcome"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "prev_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prev Hash",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "ref_seq": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ref Seq"
    },
    "request_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Hash"
    },
    "scan_id": {
      "pattern": "^scan_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "task": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "token_counts": {
      "$ref": "#/$defs/TokenCounts"
    }
  },
  "required": [
    "seq",
    "timestamp",
    "scan_id",
    "candidate_id",
    "provider",
    "model",
    "level",
    "payload_hash",
    "prev_hash",
    "entry_hash",
    "token_counts",
    "outcome"
  ],
  "title": "EgressRecord",
  "type": "object",
  "x-data-classification": "metadata",
  "x-schema-version": 1
}
