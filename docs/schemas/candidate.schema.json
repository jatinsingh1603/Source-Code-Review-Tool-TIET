{
  "$defs": {
    "CandidateKind": {
      "description": "Kind of candidate produced by deterministic analysis.",
      "enum": [
        "vulnerability",
        "secret",
        "dependency",
        "misconfiguration",
        "hotspot"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "Confidence": {
      "description": "Confidence in a candidate or verdict, in ascending order.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Language": {
      "description": "Source language of a file (unordered).",
      "enum": [
        "python",
        "javascript",
        "typescript",
        "java",
        "kotlin",
        "c",
        "cpp",
        "php",
        "go",
        "csharp",
        "ruby",
        "dockerfile",
        "terraform",
        "yaml",
        "json",
        "toml",
        "xml",
        "shell",
        "sql",
        "html",
        "unknown"
      ],
      "title": "Language",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "description": "A place in the client's code. Client data: never part of anything sent to an LLM.",
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "title": "Location",
      "type": "object"
    },
    "Severity": {
      "description": "Severity of a candidate or finding, in ascending order.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TaintPath": {
      "additionalProperties": false,
      "description": "Steps from a source to a sink; a sanitiser step does not make the path invalid.",
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/TaintStep"
          },
          "minItems": 2,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "TaintPath",
      "type": "object"
    },
    "TaintRole": {
      "description": "Role of a step in a taint path.",
      "enum": [
        "source",
        "propagator",
        "sanitiser",
        "sink"
      ],
      "title": "TaintRole",
      "type": "string"
    },
    "TaintStep": {
      "additionalProperties": false,
      "description": "One step of a taint path.",
      "properties": {
        "location": {
          "$ref": "#/$defs/Location"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "$ref": "#/$defs/TaintRole"
        }
      },
      "required": [
        "location",
        "role"
      ],
      "title": "TaintStep",
      "type": "object"
    }
  },
  "$id": "urn:codekavach:schema:candidate:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A possible weakness reported by an engine, rule or detector.",
  "properties": {
    "cwe": {
      "default": [],
      "items": {
        "ge": 1,
        "le": 99999,
        "type": "integer"
      },
      "title": "Cwe",
      "type": "array"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "engine_confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine_severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Version"
    },
    "fingerprint": {
      "pattern": "^ckfp1:[0-9a-f]{32}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "pattern": "^cand_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CandidateKind",
      "default": "vulnerability"
    },
    "language": {
      "$ref": "#/$defs/Language",
      "default": "unknown"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "minItems": 1,
      "title": "Locations",
      "type": "array"
    },
    "message": {
      "default": "",
      "description": "Engine message; local only. For secret candidates it must never contain the secret value.",
      "maxLength": 2000,
      "title": "Message",
      "type": "string"
    },
    "properties": {
      "default": [],
      "description": "Engine-specific key and value pairs; local only. For secret candidates they must never contain the secret value.",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "maxItems": 32,
      "title": "Properties",
      "type": "array"
    },
    "rule_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "taint_path": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaintPath"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "rule_id",
    "engine",
    "locations",
    "fingerprint"
  ],
  "title": "Candidate",
  "type": "object",
  "x-data-classification": "raw",
  "x-schema-version": 1
}
