<!doctype html>
{# Compliance annex: autoescaped, sandboxed; no script, no remote resource. #}
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Compliance annex: {{ doc.project_name }}</title>
<style>{{ css }}</style>
</head>
<body>
<div class="banner">{{ header }}</div>
<main>
<h2>Compliance annex</h2>
<p class="muted">{{ doc.title }} · {{ doc.project_name }} · {{ doc.report_id }} · prepared for {{ doc.prepared_for }}</p>
<div class="callout"><div class="head">How to read this annex</div><p>Each control lists the findings of this review that are evidence against it. A finding against a control does not on its own establish non-compliance, and a control with no finding was not necessarily tested. Mappings marked derived come from the weakness class of the finding.</p></div>
{% for framework in frameworks %}
<h3>{{ framework }}</h3>
<table><thead><tr><th>Control</th><th>Title</th><th>Findings</th><th>Highest severity</th></tr></thead><tbody>
{% for row in rows if row.framework == framework %}
<tr><td class="mono nowrap">{{ row.clause }}</td><td>{{ row.title or '' }}</td><td>{% for rid in row.ids %}<span class="chip">{{ rid }}</span>{% endfor %}</td><td><span class="sev sev-{{ tops[row.clause ~ row.framework] }}">{{ tops[row.clause ~ row.framework] }}</span></td></tr>
{% endfor %}
</tbody></table>
{% else %}<p>No mappings.</p>{% endfor %}
<footer class="end">Generated by CodeKavach {{ doc.scan.codekavach_version }} · scan {{ doc.scan.id }}</footer>
</main>
</body>
</html>
