<!doctype html>
{#
  CodeKavach audit report: one template for the interactive HTML file and the WeasyPrint PDF.

  Security: client code and model text are attacker-influenced. Autoescaping is on for every value
  and nothing from the document is marked safe; the only Markup inserted is the stylesheet, the
  script and the chart SVG, all generated by CodeKavach from validated theme values and numbers,
  with every text value XML-escaped. Inline style and script are permitted by the CSP because the
  file must be self-contained; what compensates is that the CSP forbids every fetch (default-src
  'none', no connect, no form action), the script reads only data attributes and writes only
  textContent, classes and the URL fragment, and no remote resource is referenced anywhere.
#}
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="CodeKavach {{ doc.scan.codekavach_version }}">
<title>{{ doc.title }}: {{ doc.project_name }}</title>
<style>{{ css }}</style>
</head>
<body>
{% set att = doc.privacy_attestation %}
{% set facts = doc.facts %}
<span class="doctitle">{{ doc.title }} · {{ doc.project_name }}</span>
{% if not pdf %}
<div class="banner">{{ doc.classification }}</div>
<div class="topbar"><div class="in">
  <div class="brand">CodeKavach<span>{{ doc.report_id }} · {{ doc.project_name }}</span></div>
  <div><button type="button" id="ck-expand">Expand all</button><button type="button" id="ck-theme" aria-label="Toggle dark mode">Theme</button><button type="button" id="ck-print">Print</button></div>
</div></div>
{% endif %}
<main>

<header class="cover" id="cover">
  <span class="mark">{{ doc.classification }}</span>
  <svg class="shield" viewBox="0 0 120 140" aria-hidden="true"><path d="M60 4 L112 24 V66 C112 100 90 124 60 136 C30 124 8 100 8 66 V24 Z" fill="rgba(255,255,255,0.10)" stroke="rgba(255,255,255,0.75)" stroke-width="3"/><path d="M38 70 L54 86 L86 52" fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <div class="kicker">Security Assessment Report</div>
  <h1>{{ doc.title }}</h1>
  <div class="project">{{ doc.project_name }}</div>
  <dl>
    <div><dt>Prepared for</dt><dd>{{ doc.prepared_for }}</dd></div>
    <div><dt>Prepared by</dt><dd>{{ doc.organisation }}</dd></div>
    <div><dt>Report ID</dt><dd>{{ doc.report_id }}</dd></div>
    <div><dt>Version</dt><dd>{{ doc.version }}</dd></div>
    <div><dt>Issue date</dt><dd>{{ doc.control.issue_date if doc.control else doc.generated_at.strftime('%d %B %Y') }}</dd></div>
    <div><dt>Overall risk</dt><dd>{{ facts.posture if facts else 'n/a' }}</dd></div>
  </dl>
</header>

{% if doc.control %}
<section class="chapter" id="control">
<h2>Document control</h2>
<table class="kv">
  <tr><th>Report identifier</th><td>{{ doc.control.report_id }}</td></tr>
  <tr><th>Document version</th><td>{{ doc.control.version }}</td></tr>
  <tr><th>Issue date</th><td>{{ doc.control.issue_date }}</td></tr>
  <tr><th>Classification</th><td><strong>{{ doc.control.classification.label }}</strong>. {{ doc.control.classification.handling_note }}</td></tr>
  <tr><th>Prepared by</th><td>{{ doc.control.prepared_by }}</td></tr>
  <tr><th>Prepared for</th><td>{{ doc.control.prepared_for }}</td></tr>
  <tr><th>Scan identifier</th><td class="mono">{{ doc.scan.id }}</td></tr>
  <tr><th>Configuration digest</th><td class="mono">{{ doc.scan.config_hash }}</td></tr>
  {% if doc.scan.git_commit %}<tr><th>Commit</th><td class="mono">{{ doc.scan.git_commit }}{% if doc.scan.git_branch %} ({{ doc.scan.git_branch }}){% endif %}</td></tr>{% endif %}
</table>
<h3>Version history</h3>
<table><thead><tr><th>Version</th><th>Date</th><th>Author</th><th>Change</th><th>State</th></tr></thead><tbody>
{% for v in doc.control.versions %}<tr><td>{{ v.version }}</td><td>{{ v.date }}</td><td>{{ v.author }}</td><td>{{ v.change }}</td><td>{{ v.state }}</td></tr>{% endfor %}
</tbody></table>
<div class="two">
<div><h3>Distribution</h3>
<table><thead><tr><th>Name</th><th>Role</th><th>Organisation</th></tr></thead><tbody>
{% for d in doc.control.distribution %}<tr><td>{{ d.name }}</td><td>{{ d.role }}</td><td>{{ d.organisation }}</td></tr>{% endfor %}
</tbody></table></div>
<div><h3>Approval</h3>
<table><thead><tr><th>Role</th><th>Name</th><th>Signature / date</th></tr></thead><tbody>
{% for s in doc.control.sign_offs %}<tr><td>{{ s.role }}</td><td>{{ s.name }}</td><td>{{ s.date if s.signed else '' }}&nbsp;</td></tr>{% endfor %}
</tbody></table></div>
</div>
<p class="small muted">{{ doc.control.disclaimer }}</p>
{% if doc.control.copyright_notice %}<p class="small muted">{{ doc.control.copyright_notice }}</p>{% endif %}
</section>
{% endif %}

<section class="chapter cont" id="contents">
<nav class="toc" aria-label="Contents">
<h2>Contents</h2>
<ol>
  {% for anchor, label in toc %}<li><a href="#{{ anchor }}"><span class="n">{{ loop.index }}</span>{{ label }}</a></li>{% endfor %}
</ol>
</nav>
</section>

<section class="chapter" id="executive">
<h2><span class="num">1</span>Executive summary</h2>
{% if facts %}
<div class="posture {{ facts.posture|lower }}"><div class="word">{{ facts.posture }} risk</div><div>Overall security posture of {{ doc.project_name }} based on {{ facts.total }} finding{{ '' if facts.total == 1 else 's' }}{% if att %} at privacy level {{ att.default_level }}{% endif %}.</div></div>
<div class="kpis">
  {% for name, count in facts.by_severity %}<div class="kpi {{ name }}"><div class="v">{{ count }}</div><div class="l">{{ name }}</div></div>{% endfor %}
</div>
{% endif %}
{% set first = doc.executive[0] if doc.executive else none %}
<div class="split">
<div style="flex: 3 1 420px">
{% if first %}
  {% for paragraph in first.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
  {% if first.bullets %}<ul>{% for item in first.bullets %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
{% endif %}
</div>
<div style="flex: 1 1 180px"><div class="chart-card donut"><h4>Severity distribution</h4>{{ charts.donut }}</div></div>
</div>
{% for block in doc.executive[1:] %}
  <h3>{{ block.heading }}</h3>
  {% for paragraph in block.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
  {% if block.bullets %}<ul>{% for item in block.bullets %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
{% endfor %}
</section>

<section class="chapter" id="scope">
<h2><span class="num">2</span>Scope and approach</h2>
{% if doc.scope %}
<table class="kv">
  <tr><th>Client</th><td>{{ doc.scope.client_name }}</td></tr>
  <tr><th>Engagement</th><td>{{ doc.scope.engagement_id }}: {{ doc.scope.engagement_type }}</td></tr>
  <tr><th>Review period</th><td>{{ doc.scope.period_start }}{% if doc.scope.period_end != doc.scope.period_start %} to {{ doc.scope.period_end }}{% endif %}</td></tr>
  {% for t in doc.scope.targets %}
  <tr><th>Target</th><td>{{ t.repository }}{% if t.commit %} at <span class="mono">{{ t.commit[:12] }}</span>{% endif %}{% if t.branch %} ({{ t.branch }}){% endif %}</td></tr>
  <tr><th>Languages</th><td>{{ t.languages|join(', ') or 'n/a' }}</td></tr>
  {% if t.paths_excluded %}<tr><th>Excluded paths</th><td class="mono">{{ t.paths_excluded|join(', ') }}</td></tr>{% endif %}
  {% endfor %}
  <tr><th>Files analysed</th><td>{{ doc.coverage.files_analysed }} files, {{ '{:,}'.format(doc.coverage.lines_analysed) }} lines</td></tr>
  <tr><th>Candidates triaged</th><td>{{ doc.coverage.candidates_total }} candidates; {{ doc.coverage.candidates_reviewed_by_llm }} reviewed by the model</td></tr>
</table>
<h3>Objectives</h3>
<ul>{% for o in doc.scope.objectives %}<li>{{ o }}</li>{% endfor %}</ul>
<h3>Assumptions</h3>
<ul>{% for a in doc.scope.assumptions %}<li>{{ a }}</li>{% endfor %}</ul>
{% endif %}
</section>

<section class="chapter" id="methodology">
<h2><span class="num">3</span>Methodology</h2>
<p>The review followed the phases of NIST SP 800-115 and the OWASP Code Review Guide, executed by the CodeKavach pipeline. Deterministic analysis finds candidates; a language model, reached only through a privacy-preserving egress guard, assesses them; every finding is then rated and mapped to recognised taxonomies.</p>
<table><thead><tr><th>Phase</th><th>Step</th><th>Description</th></tr></thead><tbody>
{% for s in doc.methodology.steps %}<tr><td><strong>{{ s.phase.value|title }}</strong></td><td>{{ s.title }}</td><td>{{ s.description }}</td></tr>{% endfor %}
</tbody></table>
<h3>Privacy levels</h3>
<p>What leaves the client environment is governed by the privacy level. This review ran at <strong>{{ att.default_level if att else doc.scan.privacy_level.value }}</strong>.</p>
<table><thead><tr><th>Level</th><th>Name</th><th>What is sent to the model</th></tr></thead><tbody>
{% for p in doc.methodology.privacy_levels %}<tr{% if att and p.level == att.default_level %} style="font-weight:600"{% endif %}><td>{{ p.level }}</td><td>{{ p.name }}</td><td>{{ p.sends }}</td></tr>{% endfor %}
</tbody></table>
{% if doc.methodology.techniques_not_performed %}<h3>Techniques not performed</h3><ul>{% for t in doc.methodology.techniques_not_performed %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
</section>

<section class="chapter" id="rating">
<h2><span class="num">4</span>Risk rating method</h2>
<div class="split">
<div>
<h3>Severity</h3>
<table><thead><tr><th>Severity</th><th>CVSS</th><th>Meaning</th></tr></thead><tbody>
{% for name, band, meaning in doc.rating_method.severity_scale %}<tr><td><span class="sev sev-{{ name }}">{{ name }}</span></td><td>{{ band }}</td><td>{{ meaning }}</td></tr>{% endfor %}
</tbody></table>
<p class="small">{{ doc.rating_method.cvss_nomenclature }}</p>
</div>
<div>
<h3>Likelihood and impact</h3>
<p class="small">Risk is the product of likelihood and impact on a five-point scale (1 to 25). Products of 20 and above are critical, 12 to 19 high, 6 to 11 medium, 3 to 5 low and below 3 informational.</p>
<table><thead><tr><th>#</th><th>Likelihood</th><th>Impact</th></tr></thead><tbody>
{% for (n, l), (_, i) in zip(doc.rating_method.likelihood_scale, doc.rating_method.impact_scale) %}<tr><td>{{ n }}</td><td>{{ l }}</td><td>{{ i }}</td></tr>{% endfor %}
</tbody></table>
</div>
</div>
<p class="small">{{ doc.rating_method.cwe_mapping_rule }} {{ doc.rating_method.confidence_rule }}</p>
</section>

<section class="chapter" id="summary">
<h2><span class="num">5</span>Summary of findings</h2>
<div class="split">
  <div><div class="chart-card"><h4>Findings by severity</h4>{{ charts.severity }}</div></div>
  <div><div class="chart-card"><h4>Risk matrix (likelihood by impact)</h4>{{ charts.matrix }}</div></div>
</div>
<div class="split bars">
  <div><div class="chart-card"><h4>Top weakness classes (CWE)</h4>{{ charts.cwe }}</div></div>
  <div><div class="chart-card"><h4>OWASP Top 10 (2021) categories</h4>{{ charts.owasp }}</div></div>
</div>
<table id="summary-table"><thead><tr><th>ID</th><th>Severity</th><th>Title</th><th>CWE</th><th>Location</th><th>Risk</th><th>Status</th></tr></thead><tbody>
{% for v in views %}<tr><td class="mono nowrap"><a href="#{{ v.report_id }}">{{ v.report_id }}</a></td><td><span class="sev sev-{{ v.severity }}">{{ v.severity }}</span></td><td>{{ v.title }}</td><td class="cwe">{{ v.cwe_label }}</td><td class="mono small">{{ v.location_label }}</td><td class="nowrap">{{ v.risk_score }} · {{ v.risk_band }}</td><td class="status">{{ v.status|replace('_', ' ') }}</td></tr>
{% else %}<tr><td colspan="7">No findings were identified.</td></tr>{% endfor %}
</tbody></table>
</section>

<section class="chapter" id="findings">
<h2><span class="num">6</span>Detailed findings</h2>
{% if not pdf and views %}
<div class="toolbar" role="search">
  <input type="search" id="ck-q" placeholder="Search title, ID, CWE or file" aria-label="Search findings">
  <select id="ck-sev" aria-label="Severity"><option value="">All severities</option>{% for s in ['critical','high','medium','low','info'] %}<option value="{{ s }}">{{ s|title }}</option>{% endfor %}</select>
  <select id="ck-status" aria-label="Status"><option value="">All statuses</option>{% for s in statuses %}<option value="{{ s }}">{{ s|replace('_',' ')|title }}</option>{% endfor %}</select>
  <select id="ck-cwe" aria-label="CWE"><option value="">All CWEs</option>{% for c in cwes %}<option value="CWE-{{ c }}">CWE-{{ c }}</option>{% endfor %}</select>
  <select id="ck-sort" aria-label="Sort"><option value="sev">Sort: severity</option><option value="id">Sort: ID</option><option value="cwe">Sort: CWE</option><option value="file">Sort: file</option></select>
  <button type="button" id="ck-clear">Clear filters</button>
  <span class="count" id="ck-count" aria-live="polite">{{ views|length }} of {{ views|length }} findings</span>
</div>
{% endif %}
<div id="ck-list">
{% for v in views %}
{% if pdf %}<article class="finding {{ v.severity }}" id="{{ v.report_id }}">
<div class="fhead"><span class="rid">{{ v.report_id }}</span> <span class="sev sev-{{ v.severity }}">{{ v.severity }}</span> <span class="status muted">· {{ v.status|replace('_',' ') }}</span><span class="ttl">{{ v.title }}</span></div>
{% else %}<details class="finding {{ v.severity }}" id="{{ v.report_id }}" data-severity="{{ v.severity }}" data-rank="{{ v.severity_rank }}" data-status="{{ v.status }}" data-cwe="{{ v.cwe_label }}" data-file="{{ v.primary_path }}" data-line="{{ v.primary_line }}" data-search="{{ (v.report_id ~ ' ' ~ v.title ~ ' ' ~ v.cwe_label ~ ' ' ~ v.primary_path ~ ' ' ~ v.owasp_label)|lower }}">
<summary><span class="rid">{{ v.report_id }}</span><span class="ttl">{{ v.title }}</span><span class="loc">{{ v.location_label }}</span><span class="sev sev-{{ v.severity }}">{{ v.severity }}</span></summary>
{% endif %}
<div class="fbody">
  <div class="facts">
    <div class="fact"><div class="k">Severity</div><div class="v">{{ v.severity|title }}</div></div>
    <div class="fact"><div class="k">Risk (L × I)</div><div class="v">{{ v.likelihood }} × {{ v.impact_level }} = {{ v.risk_score }} ({{ v.risk_band }})</div></div>
    <div class="fact"><div class="k">Confidence</div><div class="v">{{ v.confidence|title }}</div></div>
    <div class="fact"><div class="k">Status</div><div class="v">{{ v.status|replace('_',' ')|title }}</div></div>
    <div class="fact"><div class="k">Priority</div><div class="v">{{ v.priority }} · {{ v.lane }}</div></div>
    {% if v.rating.owasp_overall %}<div class="fact"><div class="k">OWASP risk rating</div><div class="v">{{ v.rating.owasp_overall|title }} (likelihood {{ v.rating.owasp_likelihood_band }}, impact {{ v.rating.owasp_impact_band }})</div></div>{% endif %}
    <div class="fact"><div class="k">CVSS v4.0{% if v.rating.cvss4_nomenclature %} ({{ v.rating.cvss4_nomenclature }}){% endif %}</div><div class="v{{ ' mono' if v.rating.cvss4_vector }}">{% if v.rating.cvss4_vector %}<strong>{{ v.rating.cvss4_score }}</strong> · {{ v.rating.cvss4_vector }}{% else %}Not scored{% endif %}</div></div>
    <div class="fact"><div class="k">CVSS v3.1</div><div class="v{{ ' mono' if v.rating.cvss31_vector }}">{% if v.rating.cvss31_vector %}{{ v.rating.cvss31_score if v.rating.cvss31_score is not none else '' }} · {{ v.rating.cvss31_vector }}{% else %}Not scored{% endif %}</div></div>
    <div class="fact"><div class="k">CWE</div><div class="v">{% for c in v.cwe %}CWE-{{ c }} {{ v.cwe_names[loop.index0] }}{% if not loop.last %}; {% endif %}{% else %}n/a{% endfor %}{% if v.cwe_top25 %} <span class="chip">Top 25{% if v.rating.top25_rank %} #{{ v.rating.top25_rank }}{% endif %}</span>{% endif %}</div></div>
    <div class="fact"><div class="k">OWASP Top 10</div><div class="v">{{ v.owasp_label }}</div></div>
    <div class="fact"><div class="k">ASVS · CAPEC</div><div class="v">{{ v.asvs|join(', ') or 'n/a' }} · {{ v.capec|join(', ') or 'n/a' }}</div></div>
    <div class="fact"><div class="k">Location</div><div class="v mono">{{ v.locations|join(', ') }}{% if v.symbol %} in {{ v.symbol }}{% endif %}</div></div>
    <div class="fact"><div class="k">Detected by</div><div class="v mono">{{ v.detected_by|join(', ') or v.origin }}</div></div>
  </div>
  <h4>Description</h4>
  <p>{{ v.description }}</p>
  {% for e in v.evidence %}
  <h4>Evidence{% if v.evidence|length > 1 %} ({{ e.role }}){% endif %}</h4>
  <div class="code"><div class="cap">{{ e.path }} · lines {{ e.start_line }}{% if e.end_line != e.start_line %}-{{ e.end_line }}{% endif %}{% if e.caption %} · {{ e.caption }}{% endif %}{% if e.masked_values %} · {{ e.masked_values }} secret value{{ "" if e.masked_values == 1 else "s" }} masked{% endif %}</div>
  <pre aria-label="Evidence from {{ e.path }}">{% for row in snippet_rows(e) %}<span class="ln{{ ' hit' if row.marked else '' }}"><span class="no">{{ row.number }}</span>{{ row.html }}</span>{% endfor %}</pre></div>
  {% endfor %}
  {% if v.flow %}
  <h4>Data flow (source to sink)</h4>
  <ol class="flow">{% for s in v.flow %}<li class="{{ s.role }}" data-line="{{ s.line }}"><span class="role">{{ s.role }}</span><span class="mono">{{ s.path }}:{{ s.line }}</span>{% if s.symbol %} · {{ s.symbol }}{% endif %}{% if s.note %} · {{ s.note }}{% endif %}</li>{% endfor %}</ol>
  {% endif %}
  {% if v.verdict %}
  <div class="callout model"><div class="head">Model assessment: {{ v.verdict.label }} ({{ v.verdict.confidence }} confidence)</div>
  {% if v.verdict.reasoning %}<p>{{ v.verdict.reasoning }}</p>{% endif %}
  <div class="small muted">{{ v.verdict.provider }} / {{ v.verdict.model }} · task {{ v.verdict.task }} · privacy level {{ v.verdict.level }}{% if v.verdict.ledger_seq %} · ledger entry #{{ v.verdict.ledger_seq }}{% endif %}. Advisory: the model cannot close a finding.</div></div>
  {% endif %}
  <div class="two">
    <div><h4>Impact</h4><p>{{ v.impact }}</p></div>
    <div><h4>Likelihood</h4><p>{{ v.likelihood_rationale or ('Rated ' ~ v.likelihood ~ ' of 5: ' ~ likelihood_text[v.likelihood]) }}</p></div>
  </div>
  <h4>Remediation</h4>
  <div class="callout ok"><div class="head">Fix now</div><p>{{ v.remediation_short_term }}</p></div>
  <div class="callout"><div class="head">Prevent recurrence</div><p>{{ v.remediation_long_term }}</p><div class="small muted">Estimated effort: {{ v.remediation_effort }} · target {{ v.lane_window }}</div></div>
  {% if v.compliance %}<h4>Compliance mapping</h4><p>{% for c in v.compliance %}<span class="chip{{ ' derived' if c.derived }}" title="{{ c.title or '' }}">{{ c.framework }} {{ c.clause }}</span>{% endfor %}</p>{% if v.compliance|selectattr('derived')|list %}<p class="small muted">Dashed: mapping derived from the weakness class; evidence against the clause, not an opinion of compliance.</p>{% endif %}{% endif %}
  {% if v.references %}<h4>References</h4><ul class="small">{% for title, url in v.references %}<li>{{ title }}{% if url %} <span class="mono muted">{{ url }}</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
  <p class="small muted mono">Finding {{ v.finding_id }} · fingerprint {{ v.fingerprint }}</p>
</div>
{% if pdf %}</article>{% else %}</details>{% endif %}
{% else %}
<p>No findings were identified by the techniques applied.</p>
{% endfor %}
</div>
</section>

<section class="chapter" id="roadmap">
<h2><span class="num">7</span>Remediation roadmap</h2>
<p>Actions are grouped by weakness class so that one change closes every instance, ordered by priority, then by the number of findings closed and the estimated effort.</p>
<table id="roadmap-table"><thead><tr><th>Priority</th><th>Timeline</th><th>Weakness</th><th>Action</th><th>Effort</th><th>Findings</th></tr></thead><tbody>
{% for r in doc.roadmap %}<tr><td><span class="prio">{{ r.priority }}</span></td><td class="lane">{{ r.lane }}<div class="small muted">{{ r.window }}</div></td><td>{{ r.theme }}</td><td>{{ r.action }}</td><td>{{ r.effort|title }}</td><td class="mono small">{{ r.report_ids|join(', ') }}</td></tr>
{% else %}<tr><td colspan="6">No open findings require remediation.</td></tr>{% endfor %}
</tbody></table>
</section>

{% if att %}
<section class="chapter" id="privacy">
<h2><span class="num">8</span>Privacy attestation</h2>
<div class="attest">
<p><span class="seal{{ '' if (att.zero_leak.passed or not att.zero_leak.checked) and att.chain_ok is not false else ' fail' }}">{{ 'Ledger verified' if att.chain_ok else ('Ledger not verified' if att.chain_ok is none else 'Ledger verification failed') }}</span>
{% if att.zero_leak.checked %} <span class="seal{{ '' if att.zero_leak.passed else ' fail' }}">Zero-leak {{ 'passed' if att.zero_leak.passed else 'FAILED' }}</span>{% endif %}</p>
<p>This attestation states exactly what left the client environment during the review. It is computed from the hash-chained egress ledger, which records every request to a language model before it is sent.</p>
{% if att.offline_notice %}<div class="callout warn">{{ att.offline_notice }}</div>{% endif %}
<table class="kv">
  <tr><th>Privacy level (default)</th><td>{{ att.default_level }}</td></tr>
  {% for pattern, level in att.levels %}<tr><th>Path pattern {{ pattern }}</th><td>{{ level }}</td></tr>{% endfor %}
  <tr><th>Provider and model</th><td>{{ att.provider or 'none' }} / {{ att.model or 'none' }} ({{ 'local' if att.provider_is_local else 'remote' }})</td></tr>
  <tr><th>Ledger entries</th><td>{{ att.ledger_entries }}{% for outcome, count in att.entries_by_outcome %}; {{ outcome }}: {{ count }}{% endfor %}</td></tr>
  <tr><th>Payloads sent / blocked</th><td>{{ att.requests_sent }} / {{ att.requests_blocked }}</td></tr>
  <tr><th>Tokens (prompt / completion)</th><td>{{ '{:,}'.format(att.tokens_prompt) }} / {{ '{:,}'.format(att.tokens_completion) }}</td></tr>
  <tr><th>Placeholders by type</th><td>{% if att.placeholders_counted %}{% for name, count in att.placeholders_by_type %}<span class="chip">{{ name }}: {{ count }}</span>{% else %}none{% endfor %}{% else %}not counted (ledger key not available to the report){% endif %}</td></tr>
  {% for name, value in att.disclosure %}<tr><th>{{ name|disclosure_label }}</th><td>{{ value }}</td></tr>{% else %}
  <tr><th>Disclosure</th><td>not recorded for this scan</td></tr>{% endfor %}
  <tr><th>Ledger head hash</th><td class="hash">{{ att.ledger_head_hash or 'no ledger entries' }}</td></tr>
  <tr><th>Chain verification</th><td>{{ att.chain_text }}</td></tr>
  <tr><th>Zero-leak check</th><td>{{ att.zero_leak.text }}</td></tr>
  <tr><th>Retention</th><td>{{ att.retention }}</td></tr>
</table>
<p class="small">{{ att.not_covered }}</p>
</div>
</section>
{% endif %}

<section class="chapter" id="appendix">
<h2><span class="num">{{ 9 if att else 8 }}</span>Appendices</h2>
<h3 id="appendix-tools">A. Tools, engines and versions</h3>
<table><thead><tr><th>Tool</th><th>Version</th><th>Role</th><th>Mode</th></tr></thead><tbody>
{% for t in doc.methodology.tools %}<tr><td>{{ t.name }}</td><td class="mono">{{ t.version }}</td><td>{{ t.role }}</td><td>{{ t.distribution_mode }}</td></tr>
{% else %}{% for name, version in doc.tools %}<tr><td>{{ name }}</td><td>{{ version }}</td><td></td><td></td></tr>{% endfor %}{% endfor %}
</tbody></table>
<h3 id="appendix-coverage">B. Coverage</h3>
<table class="kv">
  <tr><th>Files analysed</th><td>{{ doc.coverage.files_analysed }}</td></tr>
  <tr><th>Lines analysed</th><td>{{ '{:,}'.format(doc.coverage.lines_analysed) }}</td></tr>
  {% for lang, count in doc.coverage.by_language %}<tr><th>Findings in {{ lang }}</th><td>{{ count }}</td></tr>{% endfor %}
  <tr><th>Candidates</th><td>{{ doc.coverage.candidates_total }} (reviewed by model: {{ doc.coverage.candidates_reviewed_by_llm }})</td></tr>
  {% for code, count in doc.coverage.not_reviewed %}<tr><th>Not reviewed: {{ code }}</th><td>{{ count }}</td></tr>{% endfor %}
</table>
{% if doc.coverage.files_reviewed %}
<h3 id="appendix-files">C. Files reviewed</h3>
<table><thead><tr><th>#</th><th>Path</th></tr></thead><tbody>
{% for path in doc.coverage.files_reviewed %}<tr><td>{{ loop.index }}</td><td class="mono small">{{ path }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
<h3 id="appendix-compliance">{{ 'D' if doc.coverage.files_reviewed else 'C' }}. Compliance annex</h3>
<p class="small">Each row lists the findings that are evidence against a control. This is not an opinion of compliance; controls without findings were not necessarily tested.</p>
<table id="annex-table"><thead><tr><th>Framework</th><th>Control</th><th>Title</th><th>Findings</th></tr></thead><tbody>
{% for row in compliance %}<tr><td>{{ row.framework }}</td><td class="mono">{{ row.clause }}</td><td>{{ row.title or '' }}</td><td class="mono small">{{ row.ids|join(', ') }}</td></tr>
{% else %}<tr><td colspan="4">No mappings.</td></tr>{% endfor %}
</tbody></table>
<h3 id="appendix-limitations">{{ 'E' if doc.coverage.files_reviewed else 'D' }}. Limitations</h3>
<table><thead><tr><th>ID</th><th>Kind</th><th>Statement</th></tr></thead><tbody>
{% for l in doc.limitations %}<tr><td>{{ l.id }}</td><td>{{ l.kind }}</td><td>{{ l.statement }}</td></tr>{% endfor %}
</tbody></table>
<footer class="end">Generated by CodeKavach {{ doc.scan.codekavach_version }} on {{ doc.generated_at.strftime('%Y-%m-%d %H:%M UTC') }} · {{ doc.report_id }} · {{ doc.classification }}</footer>
</section>
</main>
{% if not pdf %}<script>{{ script }}</script>{% endif %}
</body>
</html>
