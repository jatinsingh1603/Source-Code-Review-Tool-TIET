<!doctype html>
{# Delta report between two scans: autoescaped, sandboxed; no script, no remote resource. #}
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Retest delta: {{ doc.project_name }}</title>
<style>{{ css }}</style>
</head>
<body>
<div class="banner">{{ header }}</div>
<main>
<h2>Retest delta report</h2>
<p class="muted">{{ doc.project_name }} · baseline {{ delta.baseline_scan }} ({{ delta.baseline_date.strftime('%d %B %Y') }}) to current {{ delta.current_scan }} ({{ delta.current_date.strftime('%d %B %Y') }})</p>
<div class="kpis">
  <div class="kpi high"><div class="v">{{ delta.new|length }}</div><div class="l">New</div></div>
  <div class="kpi critical"><div class="v">{{ delta.regressed|length }}</div><div class="l">Regressed</div></div>
  <div class="kpi info"><div class="v">{{ delta.unchanged|length }}</div><div class="l">Still open</div></div>
  <div class="kpi low"><div class="v">{{ delta.fixed|length }}</div><div class="l">Fixed</div></div>
</div>
{% for name, items in [('New findings', delta.new), ('Regressed (severity raised)', delta.regressed), ('Still open', delta.unchanged), ('Fixed or no longer present', delta.fixed)] %}
<h3>{{ name }} ({{ items|length }})</h3>
<table><thead><tr><th>ID</th><th>Severity</th><th>Title</th><th>Location</th><th>Status</th></tr></thead><tbody>
{% for e in items %}<tr><td class="mono nowrap">{{ e.report_id }}{% if items is sameas delta.fixed and e.previous_status is none %} <span class="small muted">baseline</span>{% endif %}</td><td><span class="sev sev-{{ e.severity }}">{{ e.severity }}</span>{% if e.previous_severity and e.previous_severity != e.severity %} <span class="small muted">was {{ e.previous_severity }}</span>{% endif %}</td><td>{{ e.title }}</td><td class="mono small">{{ e.location }}</td><td class="status">{{ e.status|replace('_',' ') }}</td></tr>
{% else %}<tr><td colspan="5" class="muted">None.</td></tr>{% endfor %}
</tbody></table>
{% endfor %}
<footer class="end">Findings are matched across scans by their stable fingerprint. Report IDs number the findings of each report; an ID marked "baseline" is the finding's ID in the baseline report and may name a different finding in the current one. Generated by CodeKavach {{ doc.scan.codekavach_version }}.</footer>
</main>
</body>
</html>
