# CodeKavach compose settings. Copy to .env (git-ignored) and fill in what you need:
#
#   cp .env.example .env
#
# This file holds NO real secret. Each line says whether the variable is a secret value (keep it
# out of git, chat and screenshots), a plain value, or a reference that names where a secret lives.

# Plain value: password of the built-in "admin" dashboard account (created on first start).
# Change it before anyone else can reach the port.
CODEKAVACH_ADMIN_PASSWORD=kavach-admin

# Secret value: AgentRouter API key for the real-LLM provider "agentrouter" (model gpt-5.6-sol).
# Leave empty to stay offline; the mock and replay providers need no key.
CODEKAVACH_AGENTROUTER_API_KEY=

# Secret value: passphrase that derives the key of the pseudonym vault (there is no OS keyring
# inside a container). Leave empty and the server generates a random one in its data volume
# (/data/vault.passphrase). Changing it later makes existing vaults unreadable.
CODEKAVACH_VAULT_PASSPHRASE=

# Plain values: where the dashboard listens on the host. Use 0.0.0.0 to expose it on the LAN.
CODEKAVACH_BIND=127.0.0.1
CODEKAVACH_PORT=8080

# Plain value: image tag that compose builds and runs.
CODEKAVACH_IMAGE=codekavach:local
